Options -Indexes
RewriteEngine On
# https and canonical host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^munkkicasinoo\.com$ [NC]
RewriteRule ^(.*)$ https://munkkicasinoo.com/$1 [R=301,L]
# affiliate redirect
RewriteRule ^play/?$ https://example.invalid/set-affiliate-link [R=302,L]
# /page.html and /page/ -> /page
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
# serve clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  <If "%{REQUEST_URI} =~ m#^/play#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
